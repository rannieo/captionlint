{
  "name": "captionlint-v2",
  "private": true,
  "scripts": {
    "build": "pnpm run build:web",
    "build:all": "turbo run build",
    "start": "pnpm run start:web",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start -- -p ${PORT:-3000} -H 0.0.0.0",
    "build:api": "pnpm --filter @captionlint/api build",
    "start:api": "pnpm --filter @captionlint/api start",
    "predeploy:api": "node packages/database/dist/setup.js",
    "build:worker": "pnpm --filter @captionlint/worker build",
    "start:worker": "pnpm --filter @captionlint/worker start",
    "dev": "turbo run dev",
    "dev:all": "turbo run dev --filter=@captionlint/api --filter=@captionlint/worker --filter=web",
    "dev:api": "turbo run dev --filter=@captionlint/api",
    "dev:worker": "turbo run dev --filter=@captionlint/worker",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@repo/database",
    "db:push": "turbo run db:push --filter=@repo/database"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.8",
    "typescript": "5.9.2",
    "vitest": "^4.0.7"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
