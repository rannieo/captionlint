{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @captionlint/api build"
  },
  "deploy": {
    "preDeployCommand": ["node packages/database/dist/setup.js"],
    "startCommand": "pnpm --filter @captionlint/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}
