{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bash scripts/railway-build.sh api"
  },
  "deploy": {
    "preDeployCommand": ["bash scripts/railway-predeploy.sh api"],
    "startCommand": "bash scripts/railway-start.sh api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}
